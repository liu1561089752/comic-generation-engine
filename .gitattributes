# ===== Git 属性：统一换行符，避免 Windows/Linux 混用 CRLF/LF =====
# text=auto：提交时统一转 LF，检出时按平台处理
* text=auto

# 明确按 UTF-8 文本处理的常见源码/文档类型
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env.example text eol=lf
*.txt text eol=lf

# ===== 二进制文件：禁止换行转换 =====
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.svg binary
*.zip binary
*.rar binary
*.7z binary
*.gz binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.sqlite binary
*.db binary
