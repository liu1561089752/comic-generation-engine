# ============ 应用 ============
APP_ENV=development
# 安全（必填）：生产环境（APP_ENV=production）必须设置固定值，
# JWT 签名与 API Key 加密均由它派生；留空时开发环境自动生成随机值（每次重启变化）。
APP_SECRET_KEY=change-me-to-random-key
APP_DEBUG=true
APP_LOG_LEVEL=INFO
# 首次启动创建管理员账号时使用的初始密码（生产环境务必修改）
ADMIN_INITIAL_PASSWORD=change-me

# ============ 数据库 (PostgreSQL) ============
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/webtoon_factory

# ============ 存储 ============
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

# ============ LLM (liteLLM，OpenAI 兼容) ============
LLM_API_BASE=http://127.0.0.1:5000
LLM_API_KEY=sk-mock-key
LLM_MODEL=mock-model
LLM_MAX_TOKENS=65536
LLM_TEMPERATURE=0.7

# ============ 生图模型 (OpenAI 兼容图片接口) ============
IMAGE_API_BASE=http://localhost:8567
IMAGE_API_KEY=sk-flow
IMAGE_MODEL=nano_banana_pro
IMAGE_DEFAULT_WIDTH=1920
IMAGE_DEFAULT_HEIGHT=1080
IMAGE_DEFAULT_STEPS=30
IMAGE_DEFAULT_CFG_SCALE=7.5
IMAGE_MAX_CONCURRENT=2

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ 导出 ============
EXPORT_TEMP_DIR=./data/exports
EXPORT_MAX_FILE_SIZE_MB=500
EXPORT_TARGET_DIR=F:\

# ============ 分页限制 ============
# True 表示只生成前 100 页（P1-P100），适用于排版后页数过多的场景
PAGE_LIMIT_ENABLED=true
