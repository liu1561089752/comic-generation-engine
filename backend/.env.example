# ============ 应用 ============
APP_ENV=development
APP_SECRET_KEY=change-me-to-random-key
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ============ 数据库 (PostgreSQL) ============
DATABASE_URL=postgresql+asyncpg://postgres:854223@localhost:5432/webtoon_factory

# ============ 存储 ============
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

# ============ LLM ============
LLM_API_BASE=http://192.168.0.102:9000/llm
LLM_API_KEY=sk-mock-key
LLM_MODEL=mock-model
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ============ 生图模型 (Flow API 桥接服务) ============
IMAGE_API_BASE=http://localhost:8567
IMAGE_API_KEY=sk-flow
IMAGE_MODEL=nano_banana_pro
IMAGE_DEFAULT_WIDTH=1920
IMAGE_DEFAULT_HEIGHT=1080
IMAGE_DEFAULT_STEPS=30
IMAGE_DEFAULT_CFG_SCALE=7.5
IMAGE_MAX_CONCURRENT=2

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ 导出 ============
EXPORT_TEMP_DIR=./data/exports
EXPORT_MAX_FILE_SIZE_MB=500
EXPORT_TARGET_DIR=F:\
